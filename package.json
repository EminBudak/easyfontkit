{
  "name": "easyfontkit",
  "version": "0.1.0",
  "description": "Find the fonts a website really uses, save the font files with their licenses, and get the closest free match for the paid ones.",
  "license": "MIT",
  "author": "Emin Budak",
  "homepage": "https://github.com/EminBudak/easyfontkit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EminBudak/easyfontkit.git"
  },
  "bugs": "https://github.com/EminBudak/easyfontkit/issues",
  "bin": {
    "easyfontkit": "skills/easyfontkit/scripts/easyfontkit.js"
  },
  "main": "skills/easyfontkit/scripts/lib/kit.js",
  "files": [
    "skills",
    "README.md",
    "LICENSE"
  ],
  "engines": {
